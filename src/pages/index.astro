---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import MetricsStrip from '../components/MetricsStrip.astro';
import { SITE, SOCIALS } from '../config';
import { highlights } from '../data/highlights';
import { impactMetrics } from '../data/metrics';
import { caseStudies } from '../data/caseStudies';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// The proof funnel: one-line rows, each with its single strongest number.
// The full stories live only in the case studies — this page never repeats them.
const proofTitles: Record<string, string> = {
  'reporting-platform': 'Self-service reporting platform',
  'ingestion-platform': 'DataLake & the type-safe ingestion library',
  reliability: 'Event & webhook reliability',
  'team-recovery': 'Team & project recovery',
};
const proofLines: Record<string, string> = {
  'reporting-platform':
    'Customers generate their own reports — no engineering queue, and template changes ship in about two minutes.',
  'ingestion-platform':
    'One library turned data ingestion into a minimal-effort integration for every backend team.',
  reliability:
    'Queue fairness, retries and exponential backoff — generalized so the whole platform fails less.',
  'team-recovery':
    'Rebuilt a demoralized team and delivered the projects that had already missed their deadlines.',
};
const lighthouse = highlights.find((h) => h.slug === 'lighthouse-100');

const proofRows = [
  ...caseStudies.map((study) => ({
    title: proofTitles[study.slug],
    line: proofLines[study.slug],
    metric: study.metrics[0],
    href: `/work/${study.slug}/`,
  })),
  {
    title: '100/100 × 4 Lighthouse',
    line: "Met the COO's challenge at Japan Travel with custom tree-shaking tooling — this site scores the same.",
    metric: lighthouse?.metrics[0],
    href: '/about/#proof',
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:items-center">
    <div class="flex-1">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-50">
        Hi, I'm Shafi<span class="text-blue-600 dark:text-blue-400">.</span>
      </h1>
      <p class="mt-3 text-lg font-medium text-zinc-700 dark:text-zinc-300">
        {SITE.role} · {SITE.specializations.slice(0, 3).join(' · ')}
      </p>
      <p class="mt-4 max-w-xl leading-relaxed text-zinc-600 dark:text-zinc-400">
        Backend and platform engineer with about ten years building SaaS. I design systems that
        remove bottlenecks — reporting, data ingestion, reliability — and the libraries and
        tooling that make other engineers faster. Based in Bangladesh, working globally.
      </p>
      <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-3 py-1.5 text-sm font-medium text-emerald-800 dark:bg-emerald-400/10 dark:text-emerald-300">
        <span class="h-2 w-2 shrink-0 rounded-full bg-emerald-500 dark:bg-emerald-400" aria-hidden="true" />
        {SITE.availability}
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href="/work/"
          class="rounded-lg bg-blue-600 px-5 py-2.5 font-medium text-white transition-colors hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-500"
        >
          Read the case studies
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="rounded-lg bg-zinc-900 px-5 py-2.5 font-medium text-white transition-colors hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
        >
          Get in touch
        </a>
        <a
          href="/cv/"
          class="rounded-lg border border-zinc-300 px-5 py-2.5 font-medium text-zinc-700 transition-colors hover:border-blue-600 hover:text-blue-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-blue-400 dark:hover:text-blue-400"
        >
          CV
        </a>
        <SocialLinks socials={SOCIALS.filter((s) => s.icon !== 'mail')} iconClass="h-5 w-5" />
      </div>
    </div>
    <img
      src="/images/shafi.jpg"
      alt="Portrait of Md Abdullahil Shafi"
      width="160"
      height="160"
      class="h-40 w-40 rounded-full object-cover ring-4 ring-blue-500/30"
    />
  </section>

  <!-- Impact metrics -->
  <div class="mt-16">
    <MetricsStrip metrics={impactMetrics} />
  </div>

  <!-- Proof funnel -->
  <section class="mt-16">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">
        Proof — read one, or read all four
      </h2>
      <a href="/work/" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">
        All case studies →
      </a>
    </div>
    <ul class="mt-4 divide-y divide-zinc-200 rounded-xl border border-zinc-200 bg-white dark:divide-zinc-800 dark:border-zinc-800 dark:bg-zinc-900">
      {
        proofRows.map((row) => (
          <li>
            <a href={row.href} class="group flex flex-col gap-2 p-5 transition-colors hover:bg-zinc-50 sm:flex-row sm:items-center sm:justify-between sm:gap-6 dark:hover:bg-zinc-800/50">
              <div>
                <h3 class="font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
                  {row.title}
                </h3>
                <p class="mt-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{row.line}</p>
              </div>
              {row.metric && (
                <div class="shrink-0 sm:text-right">
                  <p class="text-lg font-bold leading-tight text-blue-600 dark:text-blue-400">{row.metric.value}</p>
                  <p class="mt-0.5 text-xs leading-snug text-zinc-600 dark:text-zinc-400">{row.metric.label}</p>
                </div>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Shipped & Now -->
  <section class="mt-16 grid gap-4 lg:grid-cols-2">
    <div class="rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">Shipped</h2>
      <ul class="mt-4 space-y-3">
        <li class="leading-relaxed text-zinc-600 dark:text-zinc-400">
          <a href="/products/" class="font-semibold text-zinc-900 hover:text-blue-600 dark:text-zinc-100 dark:hover:text-blue-400">MyDokan</a>{' '}
          — my own product, live and distributed privately. <a href={`mailto:${SITE.email}`} class="text-blue-600 underline underline-offset-2 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300">Email me for access</a>.
        </li>
        <li class="leading-relaxed text-zinc-600 dark:text-zinc-400">
          <a href="https://github.com/shafi-/loop" target="_blank" rel="noopener noreferrer" class="font-semibold text-zinc-900 hover:text-blue-600 dark:text-zinc-100 dark:hover:text-blue-400">loop</a>{' '}
          — discussion rooms with LLM personas and a deterministic pipeline to run the work. Open source.
        </li>
        <li class="leading-relaxed text-zinc-600 dark:text-zinc-400">
          <a href="https://github.com/shafi-/portfolio" target="_blank" rel="noopener noreferrer" class="font-semibold text-zinc-900 hover:text-blue-600 dark:text-zinc-100 dark:hover:text-blue-400">portfolio MCP</a>{' '}
          — persistent project memory for AI agents. Open source, <a href="/tools/" class="text-blue-600 underline underline-offset-2 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300">27 tools</a>.
        </li>
      </ul>
      <a href="/products/" class="mt-4 inline-block text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">
        Everything I've shipped →
      </a>
    </div>
    <div class="rounded-xl border border-blue-500/20 bg-blue-50 p-6 dark:border-blue-400/20 dark:bg-blue-950/40">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-blue-700 dark:text-blue-400">Now</h2>
      <p class="mt-4 leading-relaxed text-zinc-700 dark:text-zinc-300">
        <strong>Senior Software Engineer</strong> at{" "}
        <a href="https://testreach.com" target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 hover:underline dark:text-blue-400">TestReach</a>,
        building reporting, data-ingestion and reliability infrastructure for a global assessment
        platform — and building with AI agents daily.
      </p>
      <p class="mt-3 leading-relaxed text-zinc-700 dark:text-zinc-300">
        <span class="font-semibold">{SITE.availability}</span>
      </p>
    </div>
  </section>

  <!-- Skills -->
  <section class="mt-16">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">Skills</h2>
      <a href="/about/#skills" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">
        The honest depth map →
      </a>
    </div>
    <p class="mt-4 max-w-2xl leading-relaxed text-zinc-600 dark:text-zinc-400">
      <strong class="text-zinc-900 dark:text-zinc-200">Daily and deep:</strong> TypeScript, Node.js,
      NestJS, PostgreSQL, MongoDB, Redis, Jest, AWS (event-driven, microservices). Strong regular
      use runs from Kubernetes, Elasticsearch and Docker to Next.js, Flutter/Dart and Supabase —
      grouped by honest depth with where each was used on the About page, not percentage bars.
    </p>
  </section>

  <!-- Latest posts -->
  <section class="mt-16">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">
        Latest writing
      </h2>
      <a href="/blog/" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">
        All posts →
      </a>
    </div>
    <ul class="mt-5 divide-y divide-zinc-200 dark:divide-zinc-800">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="group block py-4">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
                  {post.data.title}
                </h3>
                <time datetime={post.data.pubDate.toISOString()} class="text-sm text-zinc-600 dark:text-zinc-400">
                  {formatDate(post.data.pubDate)}
                </time>
              </div>
              {post.data.description && (
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{post.data.description}</p>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
