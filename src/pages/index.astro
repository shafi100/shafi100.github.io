---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import MetricsStrip from '../components/MetricsStrip.astro';
import { SITE, SOCIALS } from '../config';
import { coreSkills } from '../data/skills';
import { projects } from '../data/projects';
import { products } from '../data/products';
import { highlights } from '../data/highlights';
import { impactMetrics } from '../data/metrics';
import { caseStudySlugs } from '../data/caseStudies';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const featured = [...projects.filter((p) => p.featured), ...products.filter((p) => p.featured)];
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// highlights with a case study link to it; the rest link to their anchors
const highlightHref = (slug: string) =>
  caseStudySlugs.has(slug) ? `/work/${slug}/` : slug === 'mydokan' ? '/products/' : `/about/#${slug}`;
---

<BaseLayout>
  <!-- Hero -->
  <section class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:items-center">
    <div class="flex-1">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-50">
        Hi, I'm Shafi<span class="text-blue-600 dark:text-blue-400">.</span>
      </h1>
      <p class="mt-3 text-lg font-medium text-zinc-700 dark:text-zinc-300">
        {SITE.role} · {SITE.specializations.join(' · ')}
      </p>
      <p class="mt-4 max-w-xl leading-relaxed text-zinc-600 dark:text-zinc-400">
        Backend and platform engineer with about ten years building SaaS. I design systems that
        remove bottlenecks — reporting, data ingestion, reliability — and the libraries and
        tooling that make other engineers faster. BUET graduate, based in Bangladesh, working globally.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href="/projects/"
          class="rounded-lg bg-blue-600 px-5 py-2.5 font-medium text-white transition-colors hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
        >
          View projects
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="rounded-lg bg-zinc-900 px-5 py-2.5 font-medium text-white transition-colors hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
        >
          Get in touch
        </a>
        <a
          href="/cv/"
          class="rounded-lg border border-zinc-300 px-5 py-2.5 font-medium text-zinc-700 transition-colors hover:border-blue-600 hover:text-blue-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-blue-400 dark:hover:text-blue-400"
        >
          Résumé
        </a>
        <SocialLinks socials={SOCIALS.filter((s) => s.icon !== 'mail')} iconClass="h-5 w-5" />
      </div>
    </div>
    <img
      src="/images/shafi.jpg"
      alt="Portrait of Md Abdullahil Shafi"
      width="160"
      height="160"
      class="h-40 w-40 rounded-full object-cover ring-4 ring-blue-500/30"
    />
  </section>

  <!-- Impact metrics -->
  <div class="mt-16">
    <MetricsStrip metrics={impactMetrics} />
  </div>

  <!-- Career highlights -->
  <section class="mt-16">
    <div class="flex items-baseline justify-between">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">
        Career highlights
      </h2>
      <a href="/work/" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">
        Read the case studies →
      </a>
    </div>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        highlights.map((highlight) => (
          <a
            href={highlightHref(highlight.slug)}
            class="group flex flex-col rounded-xl border border-zinc-200 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-blue-500/50 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-blue-400/50"
          >
            <h3 class="font-semibold leading-snug text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
              {highlight.title}
            </h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {highlight.tagline}
            </p>
            {highlight.metrics[0] && (
              <p class="mt-3 text-sm font-semibold text-blue-600 dark:text-blue-400">
                {highlight.metrics[0].value}
                <span class="ml-1.5 font-normal text-zinc-500 dark:text-zinc-500">{highlight.metrics[0].label}</span>
              </p>
            )}
          </a>
        ))
      }
    </div>
  </section>

  <!-- Featured projects -->
  <section class="mt-16">
    <div class="flex items-baseline justify-between">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">
        Selected projects
      </h2>
      <a href="/projects/" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">
        All projects →
      </a>
    </div>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
        {
          featured.map((project) => {
            const isExternal = project.url?.startsWith('http');
            const content = (
              <>
                <div class="flex items-start justify-between gap-3">
                  <h3 class="text-lg font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
                    {project.name}
                  </h3>
                  {project.note && (
                    <span class="rounded-full bg-zinc-200/70 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
                      {project.note}
                    </span>
                  )}
                </div>
                <p class="mt-1 text-xs font-medium uppercase tracking-wide text-blue-600 dark:text-blue-400">
                  {project.role}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{project.description}</p>
              </>
            );
            return project.url ? (
              <a
                href={project.url}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                class="group rounded-xl border border-zinc-200 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-blue-500/50 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-blue-400/50"
              >
                {content}
              </a>
            ) : (
              <div class="group rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
                {content}
              </div>
            );
          })
        }
    </div>
  </section>

  <!-- Skills -->
  <section class="mt-16">
    <div class="flex items-baseline justify-between">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">
        Core stack
      </h2>
      <a href="/about/#skills" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">
        Full toolbox →
      </a>
    </div>
    <div class="mt-5 flex flex-wrap gap-2">
      {
        coreSkills.map((skill) => (
          <span class="rounded-lg bg-blue-500/10 px-3 py-1.5 text-sm font-semibold text-blue-700 dark:bg-blue-400/10 dark:text-blue-300">
            {skill}
          </span>
        ))
      }
    </div>
    <p class="mt-3 text-sm text-zinc-500 dark:text-zinc-500">
      Skills grouped by honest depth — daily-deep vs. strong vs. working exposure — on the
      About page, not percentage bars.
    </p>
  </section>

  <!-- Latest posts -->
  <section class="mt-16">
    <div class="flex items-baseline justify-between">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">
        Latest writing
      </h2>
      <a href="/blog/" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">
        All posts →
      </a>
    </div>
    <ul class="mt-5 divide-y divide-zinc-200 dark:divide-zinc-800">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="group block py-4">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
                  {post.data.title}
                </h3>
                <time datetime={post.data.pubDate.toISOString()} class="text-sm text-zinc-500 dark:text-zinc-500">
                  {formatDate(post.data.pubDate)}
                </time>
              </div>
              {post.data.description && (
                <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{post.data.description}</p>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Current focus -->
  <section class="mt-16 rounded-xl border border-blue-500/20 bg-blue-50 p-6 dark:border-blue-400/20 dark:bg-blue-950/40">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-blue-700 dark:text-blue-400">
      Now
    </h2>
    <p class="mt-3 leading-relaxed text-zinc-700 dark:text-zinc-300">
      Currently a <strong>Senior Software Engineer</strong> at{" "}
      <a href="https://testreach.com" target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 hover:underline dark:text-blue-400">TestReach</a>,
      building reporting, data-ingestion and reliability infrastructure for a global assessment
      platform — and running <strong>MyDokan</strong>, my own product, on the side.
    </p>
    <p class="mt-3 leading-relaxed text-zinc-700 dark:text-zinc-300">
      <span class="font-semibold">Open to:</span> senior/staff/lead engineering, platform
      architecture and technical-lead roles — and always happy to talk founding-engineer or
      early-stage CTO journeys.
    </p>
  </section>
</BaseLayout>
