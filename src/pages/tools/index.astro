---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mcpToolGroups, mcpToolCount } from '../../data/tools';
import AiToolingDiagrams from '../../components/diagrams/AiToolingDiagrams.astro';
---

<BaseLayout title="Tools — Md Abdullahil Shafi" description="Tools made by me — the portfolio MCP toolset for AI agents and the Jest Error Viewer.">
  <article>
    <header>
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">Tools</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
        A list of tools made by me — small utilities and platforms that scratch my own itches,
        published in the hope they scratch yours too.
      </p>
    </header>

    <!-- Featured: portfolio MCP -->
    <section class="mt-10 rounded-2xl border border-blue-500/25 bg-white p-8 dark:border-blue-400/25 dark:bg-zinc-900">
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">portfolio MCP</h2>
        <span class="rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800 dark:bg-blue-900/50 dark:text-blue-300">
          {mcpToolCount} MCP tools
        </span>
      </div>
      <p class="mt-3 max-w-3xl text-lg leading-relaxed text-zinc-700 dark:text-zinc-300">
        Give any AI agent a persistent memory of your entire project ecosystem.
      </p>
      <p class="mt-3 max-w-3xl leading-relaxed text-zinc-600 dark:text-zinc-400">
        Most AI coding tools see one repository at a time. portfolio is an MCP server that indexes
        every local project — structure, dependencies, technologies, features, architecture
        analyses and the relationships between projects — and exposes it to any MCP-compatible
        agent. In daily use it tracks 120+ local projects and 140+ technologies, so when I ask an
        agent about "the auth flow I used in the last three apps", it actually knows.
      </p>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          mcpToolGroups.map((group) => (
            <div class="rounded-xl border border-zinc-200 p-5 dark:border-zinc-800">
              <h3 class="text-sm font-bold uppercase tracking-wide text-zinc-900 dark:text-zinc-100">
                {group.title}
              </h3>
              <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{group.blurb}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {group.tools.map((tool) => (
                  <code class="rounded-md bg-zinc-100 px-2 py-0.5 font-mono text-xs text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">
                    {tool}
                  </code>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href="https://shafi-.github.io/portfolio/"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg bg-blue-600 px-5 py-2.5 font-medium text-white transition-colors hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600"
        >
          Documentation
        </a>
        <a
          href="https://github.com/shafi-/portfolio"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-zinc-300 px-5 py-2.5 font-medium text-zinc-700 transition-colors hover:border-blue-600 hover:text-blue-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-blue-400 dark:hover:text-blue-400"
        >
          Source on GitHub
        </a>
      </div>
    </section>

    <!-- loop & portfolio at a glance -->
    <section class="mt-6">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">
        Built in the open, with AI agents
      </h2>
      <div class="mt-5">
        <AiToolingDiagrams />
      </div>
    </section>

    <!-- Jest Error Viewer -->
    <section class="mt-6">
      <a
        href="/tools/jest-error-viewer/"
        class="group block rounded-xl border border-zinc-200 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-blue-500/50 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-blue-400/50"
      >
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
            Jest Error Viewer
          </h2>
          <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300">
            Runs in your browser
          </span>
        </div>
        <p class="mt-2 leading-relaxed text-zinc-600 dark:text-zinc-400">
          Paste a confusing Jest assertion error and get the expected vs. received values parsed,
          pretty-printed and diffed side by side.
        </p>
        <span class="mt-4 inline-block text-sm font-medium text-blue-600 dark:text-blue-400">Open tool →</span>
      </a>
    </section>

    <!-- More tools -->
    <section class="mt-6">
      <div class="rounded-xl border border-zinc-200 bg-white p-6 dark:border-zinc-800 dark:bg-zinc-900">
        <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">More tools</h2>
        <p class="mt-2 leading-relaxed text-zinc-600 dark:text-zinc-400">
          Other experiments live at{" "}
          <a
            href="https://tools.shafi.me"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-blue-600 hover:underline dark:text-blue-400">tools.shafi.me</a
          >.
        </p>
      </div>
    </section>
  </article>
</BaseLayout>
