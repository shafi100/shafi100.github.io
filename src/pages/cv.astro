---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS } from '../config';
import { experience, education } from '../data/experience';
import { coreSkills } from '../data/skills';
import { impactMetrics, additionalMetrics } from '../data/metrics';
import { projects } from '../data/projects';

const socialLine = SOCIALS.filter((s) => s.icon !== 'mail')
  .map((s) => s.label)
  .join(' · ');
const openSource = projects.filter((p) => p.category === 'Open Source');
const allMetrics = [...impactMetrics, ...additionalMetrics];
---

<BaseLayout title="Résumé — Md Abdullahil Shafi" description="Printable résumé of Md Abdullahil Shafi — Senior Software Engineer: SaaS, platform engineering, distributed systems.">
  <article class="cv mx-auto max-w-3xl">
    <style is:global>
      @media print {
        body > header,
        body > footer,
        .no-print {
          display: none !important;
        }
        html,
        body {
          background: #fff !important;
          color: #000 !important;
        }
        main {
          max-width: none !important;
          padding: 0 !important;
        }
        .cv {
          max-width: none !important;
          font-size: 10.5pt;
        }
        .cv-section {
          break-inside: avoid;
        }
        a {
          color: #000 !important;
          text-decoration: none !important;
        }
      }
      @page {
        margin: 14mm;
      }
    </style>

    <header class="border-b-2 border-zinc-900 pb-4 dark:border-zinc-100">
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">{SITE.name}</h1>
      <p class="mt-1 font-medium text-zinc-700 dark:text-zinc-300">
        {SITE.role} · {SITE.specializations.slice(0, 4).join(' · ')}
      </p>
      <p class="mt-2 text-sm font-medium text-emerald-700 dark:text-emerald-400">{SITE.availability}</p>
      <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
        Bangladesh · {SITE.email} · shafi.me/cv
      </p>
      <p class="text-sm text-zinc-600 dark:text-zinc-400">{socialLine}</p>
      <p class="mt-2 text-xs text-zinc-600 no-print dark:text-zinc-400">
        Tip: use your browser's Print → “Save as PDF” for a clean one-file résumé.
      </p>
    </header>

    <section class="cv-section mt-5">
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">Profile</h2>
      <p class="mt-2 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
        Software engineer and technical leader with about ten years of experience building
        commercial SaaS products, cloud-native backend systems, distributed platforms and
        engineering tooling. Primarily backend, platform and distributed systems, with consistent
        full-stack work. Repeatedly taken ownership beyond the role: architecture, implementation,
        mentoring, customer work, developer experience, project recovery and product ownership.
      </p>
    </section>

    <section class="cv-section mt-5">
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">Core stack</h2>
      <p class="mt-2 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">{coreSkills.join(' · ')}</p>
    </section>

    <section class="cv-section mt-5">
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">Selected impact</h2>
      <ul class="mt-2 space-y-1 text-sm text-zinc-700 dark:text-zinc-300">
        {
          allMetrics.map((metric) => (
            <li class="flex gap-2">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400" aria-hidden="true" />
              <span>
                <strong>{metric.value}</strong> — {metric.label}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cv-section mt-5">
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">Experience</h2>
      <div class="mt-3 space-y-5">
        {
          experience.map((job) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100">
                  {job.role} — {job.company}
                </h3>
                <span class="text-xs text-zinc-600 dark:text-zinc-400">{job.period}</span>
              </div>
              <p class="mt-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{job.summary}</p>
              {job.highlights && (
                <ul class="mt-1.5 space-y-1 text-sm text-zinc-700 dark:text-zinc-300">
                  {job.highlights.map((highlight) => (
                    <li class="flex gap-2">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400" aria-hidden="true" />
                      {highlight}
                    </li>
                  ))}
                </ul>
              )}
              {job.tech && (
                <p class="mt-1 text-xs text-zinc-600 dark:text-zinc-400">Stack: {job.tech.join(', ')}</p>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <section class="cv-section mt-5">
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">Open source</h2>
      <ul class="mt-2 space-y-1 text-sm text-zinc-700 dark:text-zinc-300">
        {
          openSource.map((project) => (
            <li class="flex gap-2">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400" aria-hidden="true" />
              <span>
                <strong>{project.name}</strong>
                {project.url && project.url.startsWith('http') && (
                  <span class="text-zinc-600 dark:text-zinc-400"> — {project.url.replace('https://', '')}</span>
                )}
                . {project.description}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cv-section mt-5 no-print">
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">Case studies</h2>
      <p class="mt-2 text-sm text-zinc-700 dark:text-zinc-300">
        Deep dives with before/after diagrams and honest retrospectives:{' '}
        <a href="/work/" class="font-medium text-blue-600 hover:underline dark:text-blue-400">shafi.me/work</a>
      </p>
    </section>

    <section class="cv-section mt-5">
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">Education</h2>
      <p class="mt-2 text-sm text-zinc-700 dark:text-zinc-300">
        <strong>{education[0].degree}</strong>, {education[0].school}
        <span class="text-zinc-600 dark:text-zinc-400"> · {education[0].period}</span>
      </p>
    </section>
  </article>
</BaseLayout>
