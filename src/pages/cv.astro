---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS } from '../config';
import { experience, education } from '../data/experience';
import { coreSkills } from '../data/skills';
import { impactMetrics, additionalMetrics } from '../data/metrics';
import { projects } from '../data/projects';

const socialLine = SOCIALS.filter((s) => s.icon !== 'mail')
  .map((s) => s.label)
  .join(' · ');
const openSource = projects.filter((p) => p.category === 'Open Source');
const allMetrics = [...impactMetrics, ...additionalMetrics];
const cvUrl = new URL('/cv/', Astro.site).href;

const summaryClasses =
  'flex cursor-pointer list-none select-none items-center justify-between gap-3 border-b border-zinc-200 pb-2 text-xs font-semibold uppercase tracking-widest text-zinc-600 transition-colors hover:text-zinc-900 [&::-webkit-details-marker]:hidden dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200';
const chevronClasses = 'h-3 w-3 shrink-0 transition-transform duration-200 group-open:rotate-180';
---

<BaseLayout title="Résumé — Md Abdullahil Shafi" description="Printable résumé of Md Abdullahil Shafi — Senior Software Engineer: SaaS, platform engineering, distributed systems.">
  <article class="cv mx-auto max-w-3xl">
    <style is:global>
      .cv summary::-webkit-details-marker {
        display: none;
      }
      @media print {
        body > header,
        body > footer,
        .no-print {
          display: none !important;
        }
        html,
        body {
          background: #fff !important;
        }
        main {
          max-width: none !important;
          padding: 0 !important;
        }
        .cv {
          max-width: none !important;
          font-size: 10.5pt;
        }
        /* print is monochrome: rules go light, accents go black */
        .cv * {
          color: #000 !important;
          background-color: transparent !important;
          border-color: #d4d4d4 !important;
        }
        .cv summary svg {
          display: none !important;
        }
        /* JS opens collapsed sections via beforeprint; this covers browsers
           that support styling the hidden slot directly */
        .cv details::details-content {
          content-visibility: visible !important;
        }
        .cv-section {
          break-inside: avoid;
        }
        a {
          text-decoration: none !important;
        }
      }
      @page {
        margin: 14mm;
      }
    </style>

    <header>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-50">{SITE.name}</h1>
      <p class="mt-2 text-base text-zinc-600 dark:text-zinc-400">
        {SITE.role} · {SITE.specializations.slice(0, 4).join(' · ')}
      </p>
      <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-3 py-1 text-sm font-medium text-emerald-800 dark:bg-emerald-400/10 dark:text-emerald-300">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500 dark:bg-emerald-400" aria-hidden="true" />
        {SITE.availability}
      </p>
      <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
        Bangladesh · {SITE.email} · shafi.me/cv
      </p>
      <p class="mt-0.5 text-sm text-zinc-600 dark:text-zinc-400">{socialLine}</p>

      <div class="mt-4 flex flex-wrap items-center gap-3 no-print">
        <button
          id="cv-print"
          type="button"
          class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 font-medium text-white transition-colors hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-500"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z"
            />
          </svg>
          Save as PDF
        </button>
        <button
          id="cv-share"
          type="button"
          data-cv-url={cvUrl}
          class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 px-5 py-2.5 font-medium text-zinc-700 transition-colors hover:border-blue-600 hover:text-blue-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-blue-400 dark:hover:text-blue-400"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-1.757 1.757"
            />
          </svg>
          Share
        </button>
        <button
          id="cv-toggle-all"
          type="button"
          class="px-2 py-2.5 text-sm font-medium text-zinc-600 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
        >
          Collapse all
        </button>
        <span id="cv-share-status" class="text-sm font-medium text-emerald-700 dark:text-emerald-400" role="status"></span>
      </div>
    </header>

    <details class="cv-section group mt-10" open>
      <summary class={summaryClasses}>
        <h2>Profile</h2>
        <svg class={chevronClasses} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 4.5 6 8l3.5-3.5" />
        </svg>
      </summary>
      <div class="mt-3">
        <p class="text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
          Software engineer and technical leader with about ten years of experience building
          commercial SaaS products, cloud-native backend systems, distributed platforms and
          engineering tooling. Primarily backend, platform and distributed systems, with consistent
          full-stack work. Repeatedly taken ownership beyond the role: architecture, implementation,
          mentoring, customer work, developer experience, project recovery and product ownership.
        </p>
      </div>
    </details>

    <details class="cv-section group mt-10" open>
      <summary class={summaryClasses}>
        <h2>Core stack</h2>
        <svg class={chevronClasses} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 4.5 6 8l3.5-3.5" />
        </svg>
      </summary>
      <div class="mt-3">
        <p class="text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">{coreSkills.join(' · ')}</p>
      </div>
    </details>

    <details class="cv-section group mt-10" open>
      <summary class={summaryClasses}>
        <h2>Selected impact</h2>
        <svg class={chevronClasses} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 4.5 6 8l3.5-3.5" />
        </svg>
      </summary>
      <div class="mt-4">
        <dl class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
          {
            allMetrics.map((metric) => (
              <div class="flex flex-col">
                <dt class="order-2 text-sm leading-snug text-zinc-600 dark:text-zinc-400">{metric.label}</dt>
                <dd class="order-1 font-bold text-zinc-900 dark:text-zinc-100">{metric.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </details>

    <details class="cv-section group mt-10" open>
      <summary class={summaryClasses}>
        <h2>Experience</h2>
        <svg class={chevronClasses} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 4.5 6 8l3.5-3.5" />
        </svg>
      </summary>
      <div class="mt-4 space-y-6">
        {
          experience.map((job) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">
                  {job.role} — {job.company}
                </h3>
                <span class="text-sm text-zinc-600 dark:text-zinc-400">{job.period}</span>
              </div>
              <p class="mt-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{job.summary}</p>
              {job.highlights && (
                <ul class="mt-2 space-y-1.5 text-sm text-zinc-700 dark:text-zinc-300">
                  {job.highlights.map((highlight) => (
                    <li class="flex gap-2">
                      <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400" aria-hidden="true" />
                      {highlight}
                    </li>
                  ))}
                </ul>
              )}
              {job.tech && (
                <p class="mt-2 text-xs text-zinc-600 dark:text-zinc-400">Stack: {job.tech.join(', ')}</p>
              )}
            </div>
          ))
        }
      </div>
    </details>

    <details class="cv-section group mt-10" open>
      <summary class={summaryClasses}>
        <h2>Open source</h2>
        <svg class={chevronClasses} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 4.5 6 8l3.5-3.5" />
        </svg>
      </summary>
      <div class="mt-3">
        <ul class="space-y-2 text-sm text-zinc-700 dark:text-zinc-300">
          {
            openSource.map((project) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-zinc-400" aria-hidden="true" />
                <span>
                  <strong class="font-semibold">{project.name}</strong>
                  {project.url && project.url.startsWith('http') && (
                    <span class="text-zinc-600 dark:text-zinc-400"> — {project.url.replace('https://', '')}</span>
                  )}
                  . {project.description}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </details>

    <details class="cv-section group mt-10 no-print" open>
      <summary class={summaryClasses}>
        <h2>Case studies</h2>
        <svg class={chevronClasses} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 4.5 6 8l3.5-3.5" />
        </svg>
      </summary>
      <div class="mt-3">
        <p class="text-sm text-zinc-700 dark:text-zinc-300">
          Deep dives with before/after diagrams and honest retrospectives:{' '}
          <a href="/work/" class="font-medium text-blue-600 hover:underline dark:text-blue-400">shafi.me/work</a>
        </p>
      </div>
    </details>

    <details class="cv-section group mt-10" open>
      <summary class={summaryClasses}>
        <h2>Education</h2>
        <svg class={chevronClasses} viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.5 4.5 6 8l3.5-3.5" />
        </svg>
      </summary>
      <div class="mt-3">
        <p class="text-sm text-zinc-700 dark:text-zinc-300">
          <strong class="font-semibold">{education[0].degree}</strong>, {education[0].school}
          <span class="text-zinc-600 dark:text-zinc-400"> · {education[0].period}</span>
        </p>
      </div>
    </details>
  </article>

  <script>
    const sections = [...document.querySelectorAll<HTMLDetailsElement>('details.cv-section')];

    // Expand/collapse all — the label always reflects the current state.
    const toggleAll = document.getElementById('cv-toggle-all');
    const allOpen = () => sections.every((section) => section.open);
    const syncToggleAll = () => {
      if (toggleAll) toggleAll.textContent = allOpen() ? 'Collapse all' : 'Expand all';
    };
    for (const section of sections) section.addEventListener('toggle', syncToggleAll);
    toggleAll?.addEventListener('click', () => {
      const open = !allOpen();
      for (const section of sections) section.open = open;
      syncToggleAll();
    });
    syncToggleAll();

    // A print/PDF pass must include collapsed sections: open everything for
    // the print and restore the reader's own collapse state afterwards.
    let openBeforePrint: boolean[] = [];
    window.addEventListener('beforeprint', () => {
      openBeforePrint = sections.map((section) => section.open);
      for (const section of sections) section.open = true;
    });
    window.addEventListener('afterprint', () => {
      sections.forEach((section, i) => (section.open = openBeforePrint[i] ?? true));
    });

    document.getElementById('cv-print')?.addEventListener('click', () => window.print());

    // Share uses the native sheet where it exists; otherwise copy the link.
    const shareButton = document.getElementById('cv-share') as HTMLButtonElement | null;
    const status = document.getElementById('cv-share-status');
    shareButton?.addEventListener('click', async () => {
      const url = shareButton.dataset.cvUrl ?? window.location.href;
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, text: 'Résumé — Md Abdullahil Shafi', url });
        } catch {
          // reader dismissed the share sheet — nothing to do
        }
      } else {
        try {
          await navigator.clipboard.writeText(url);
          if (status) {
            status.textContent = 'Link copied';
            window.setTimeout(() => (status.textContent = ''), 2500);
          }
        } catch {
          if (status) status.textContent = 'Copy failed';
        }
      }
    });
  </script>
</BaseLayout>
