---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { caseStudies } from '../../data/caseStudies';
---

<BaseLayout
  title="Case studies — Md Abdullahil Shafi"
  description="Four engineering case studies: the reporting platform that removed an engineering bottleneck, a type-safe ingestion library as leverage, reliability at millions of events a day, and recovering a demoralized team."
>
  <article>
    <header>
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">Case studies</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
        Four pieces of work, told honestly: what the situation was, what I actually did, what
        changed, and what I would do differently. Facts are kept coarse — public site, real
        employers.
      </p>
    </header>

    <div class="mt-10 space-y-4">
      {
        caseStudies.map((study) => (
          <a
            href={`/work/${study.slug}/`}
            class="group block rounded-xl border border-zinc-200 bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-blue-500/50 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-blue-400/50"
          >
            <div class="flex flex-wrap items-baseline justify-between gap-x-4">
              <h2 class="text-lg font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
                {study.title}
              </h2>
              <span class="font-mono text-xs text-zinc-600 dark:text-zinc-400">
                {study.company} · {study.period}
              </span>
            </div>
            <p class="mt-2 leading-relaxed text-zinc-600 dark:text-zinc-400">{study.subtitle}</p>
            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5">
              {study.metrics.slice(0, 2).map((metric) => (
                <span class="text-sm">
                  <strong class="text-blue-600 dark:text-blue-400">{metric.value}</strong>
                  <span class="ml-1 text-zinc-600 dark:text-zinc-400">{metric.label}</span>
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </article>
</BaseLayout>
