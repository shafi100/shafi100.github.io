---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config';
import { caseStudies, type CaseStudy } from '../../data/caseStudies';
import ReportingBeforeAfter from '../../components/diagrams/ReportingBeforeAfter.astro';
import IngestionFlow from '../../components/diagrams/IngestionFlow.astro';
import ReliabilityFlow from '../../components/diagrams/ReliabilityFlow.astro';
import LeadershipScope from '../../components/diagrams/LeadershipScope.astro';

export function getStaticPaths() {
  return caseStudies.map((study, index) => ({
    params: { slug: study.slug },
    props: { study, prev: caseStudies[index - 1], next: caseStudies[index + 1] },
  }));
}

interface Props {
  study: CaseStudy;
  prev?: CaseStudy;
  next?: CaseStudy;
}

const { study, prev, next } = Astro.props;

const diagrams = {
  reporting: ReportingBeforeAfter,
  ingestion: IngestionFlow,
  reliability: ReliabilityFlow,
  leadership: LeadershipScope,
};
const Diagram = diagrams[study.diagram];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: study.title,
    description: study.subtitle,
    author: { '@type': 'Person', name: SITE.author, url: SITE.url },
    publisher: { '@type': 'Person', name: SITE.author },
  },
];
---

<BaseLayout title={`${study.title} — ${SITE.name}`} description={study.subtitle} jsonLd={jsonLd} markdownHref={`/work/${study.slug}.md`}>
  <article class="mx-auto max-w-3xl">
    <a href="/work/" class="text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">← All case studies</a>

    <header class="mt-6">
      <p class="font-mono text-sm text-zinc-600 dark:text-zinc-400">
        {study.companyUrl ? (
          <a href={study.companyUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">{study.company}</a>
        ) : (
          study.company
        )}
        {' · '}
        {study.period}
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 sm:text-4xl dark:text-zinc-50">{study.title}</h1>
      <p class="mt-3 text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">{study.subtitle}</p>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {
          study.tags.map((tag) => (
            <span class="rounded-full bg-zinc-200/70 px-2.5 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
              {tag}
            </span>
          ))
        }
      </div>
    </header>

    <section class="mt-10">
      <h2 class="text-sm font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">Context</h2>
      <p class="mt-3 leading-relaxed text-zinc-700 dark:text-zinc-300">{study.context}</p>
    </section>

    <section class="mt-8">
      <h2 class="text-sm font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">The problem</h2>
      <p class="mt-3 leading-relaxed text-zinc-700 dark:text-zinc-300">{study.problem}</p>
    </section>

    <section class="mt-8">
      <h2 class="text-sm font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">What I did</h2>
      <ul class="mt-3 space-y-2.5">
        {
          study.did.map((item) => (
            <li class="flex gap-3 leading-relaxed text-zinc-700 dark:text-zinc-300">
              <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500 dark:bg-blue-400" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-sm font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">What changed</h2>
      <p class="mt-3 leading-relaxed text-zinc-700 dark:text-zinc-300">{study.diagramIntro}</p>
      <div class="mt-5">
        <Diagram />
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-sm font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">The result</h2>
      <p class="mt-3 leading-relaxed text-zinc-700 dark:text-zinc-300">{study.result}</p>
      <dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
        {
          study.metrics.map((metric) => (
            <div class="rounded-xl border border-zinc-200 bg-white p-4 text-center dark:border-zinc-800 dark:bg-zinc-900">
              <dd class="text-xl font-bold text-blue-600 dark:text-blue-400">{metric.value}</dd>
              <dt class="mt-1 text-xs leading-snug text-zinc-600 dark:text-zinc-400">{metric.label}</dt>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-8 rounded-xl border-l-4 border-amber-500/60 bg-amber-500/5 p-5 dark:border-amber-400/60 dark:bg-amber-400/5">
      <h2 class="text-sm font-bold uppercase tracking-widest text-amber-700 dark:text-amber-400">What I would do differently</h2>
      <p class="mt-3 leading-relaxed text-zinc-700 dark:text-zinc-300">{study.differently}</p>
    </section>

    <nav class="mt-12 flex flex-col gap-3 border-t border-zinc-200 pt-6 text-sm sm:flex-row sm:justify-between dark:border-zinc-800" aria-label="Case study pagination">
      {
        prev ? (
          <a href={`/work/${prev.slug}/`} class="font-medium text-blue-600 hover:underline dark:text-blue-400">
            ← {prev.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/work/${next.slug}/`} class="font-medium text-blue-600 hover:underline sm:text-right dark:text-blue-400">
            {next.title} →
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
