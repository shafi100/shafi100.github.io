---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page not found">
  <section class="flex min-h-[50vh] flex-col items-center justify-center text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-blue-600 dark:text-blue-400">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">Page not found</h1>
    <p class="mt-4 max-w-md text-zinc-600 dark:text-zinc-400">
      The page you're looking for doesn't exist or has moved.
    </p>
    <a
      href="/"
      class="mt-8 rounded-lg bg-blue-600 px-5 py-2.5 font-medium text-white transition-colors hover:bg-blue-700 dark:bg-blue-600 dark:hover:bg-blue-500"
    >
      Back home
    </a>
  </section>
</BaseLayout>
