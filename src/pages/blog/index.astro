---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="Blog — Md Abdullahil Shafi" description="Technical articles and insights from my development journey — cloud, databases, performance and more.">
  <article>
    <header>
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">Blog</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
        Here I write regularly — once a year or so. 🙂 Technical articles, tips and stories from my
        development journey.
      </p>
    </header>

    <ul class="mt-10 divide-y divide-zinc-200 dark:divide-zinc-800">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="group block py-6">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h2 class="text-xl font-semibold text-zinc-900 group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
                  {post.data.title}
                </h2>
                <time datetime={post.data.pubDate.toISOString()} class="text-sm text-zinc-600 dark:text-zinc-400">
                  {formatDate(post.data.pubDate)}
                </time>
              </div>
              {post.data.description && (
                <p class="mt-2 leading-relaxed text-zinc-600 dark:text-zinc-400">
                  {post.data.description}
                </p>
              )}
              {
                post.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {post.data.tags.map((tag) => (
                      <span class="rounded-full bg-zinc-200/70 px-2.5 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
                        {tag}
                      </span>
                    ))}
                  </div>
                )
              }
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</BaseLayout>
