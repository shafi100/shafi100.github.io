---
import '../styles/global.css';
import { SITE, NAV, SOCIALS } from '../config';
import SocialLinks from '../components/SocialLinks.astro';

interface Props {
  title?: string;
  description?: string;
  /** page-specific schema.org JSON-LD objects to embed */
  jsonLd?: Record<string, unknown>[];
  /** URL of a markdown alternate version of this page */
  markdownHref?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  jsonLd,
  markdownHref,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/og-image.jpg', Astro.site);

// Global structured data: WebSite + Person, for search engines and LLMs.
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/', Astro.site).href,
      url: Astro.site?.href,
      name: SITE.title,
      description: SITE.description,
      inLanguage: 'en',
      publisher: { '@id': new URL('/#person', Astro.site).href },
    },
    {
      '@type': 'Person',
      '@id': new URL('/#person', Astro.site).href,
      name: SITE.author,
      url: SITE.url,
      email: `mailto:${SITE.email}`,
      jobTitle: SITE.role,
      description: SITE.description,
      address: { '@type': 'PostalAddress', addressCountry: 'BD' },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Bangladesh University of Engineering and Technology (BUET)',
      },
      knowsAbout: [
        'SaaS product engineering',
        'Platform engineering',
        'Distributed systems',
        'Event-driven architecture',
        'Node.js',
        'TypeScript',
        'AWS',
        'PostgreSQL',
        'MongoDB',
        'Micro-frontends',
        'LLMs',
        'AI agents',
        'Agentic workflows',
      ],
      sameAs: SOCIALS.filter((s) => s.url.startsWith('http')).map((s) => s.url),
    },
  ],
};

const toJsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('/rss.xml', Astro.site)} />
    <meta name="generator" content={Astro.generator} />

    <!-- apply saved/system theme before first paint to avoid flashing -->
    <script is:inline>
      const theme =
        localStorage.getItem('theme') ??
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={Astro.url.pathname === '/' ? 'website' : 'article'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={toJsonLd(siteJsonLd)} />
    {jsonLd && <script type="application/ld+json" set:html={toJsonLd(jsonLd)} />}
    {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
  </head>
  <body class="min-h-screen bg-zinc-50 text-zinc-800 dark:bg-zinc-950 dark:text-zinc-200">
    <header class="sticky top-0 z-10 border-b border-zinc-200/70 bg-zinc-50/80 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-950/80">
      <div class="mx-auto flex min-h-16 max-w-4xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-6 py-2">
        <a href="/" class="flex items-center gap-3 font-semibold text-zinc-900 transition-colors hover:text-blue-600 dark:text-zinc-100 dark:hover:text-blue-400">
          <img src="/images/shafi.jpg" alt="" width="32" height="32" class="h-8 w-8 rounded-full ring-2 ring-blue-500/60" />
          <span class="whitespace-nowrap">Md Abdullahil Shafi</span>
        </a>
        <nav class="flex flex-wrap items-center gap-1 sm:gap-2" aria-label="Main navigation">
          {
            NAV.map((item) => {
              const current = Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href));
              return (
                <a
                  href={item.href}
                  aria-current={current ? 'page' : undefined}
                  class:list={[
                    'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
                    current
                      ? 'text-blue-600 dark:text-blue-400'
                      : 'text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100',
                  ]}
                >
                  {item.label}
                </a>
              );
            })
          }
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            class="ml-1 inline-flex rounded-lg p-2 text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
          >
            <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1Z" />
            </svg>
            <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 18a6 6 0 1 1 0-12 6 6 0 0 1 0 12Zm0-14.5a1 1 0 0 1-1-1V1a1 1 0 1 1 2 0v1.5a1 1 0 0 1-1 1Zm0 19a1 1 0 0 1-1-1V20a1 1 0 1 1 2 0v1.5a1 1 0 0 1-1 1ZM20.5 13a1 1 0 0 1 0-2H22a1 1 0 1 1 0 2h-1.5Zm-19 0a1 1 0 0 1 0-2H3a1 1 0 0 1 0 2H1.5ZM18.36 6.64a1 1 0 0 1 0-1.42l1.06-1.06a1 1 0 1 1 1.42 1.42L19.78 6.64a1 1 0 0 1-1.42 0ZM3.16 21.84a1 1 0 0 1 0-1.42l1.06-1.06a1 1 0 0 1 1.42 1.42l-1.06 1.06a1 1 0 0 1-1.42 0Zm16.26 0-1.06-1.06a1 1 0 0 1 1.42-1.42l1.06 1.06a1 1 0 0 1-1.42 1.42ZM4.22 6.64 3.16 5.58a1 1 0 0 1 1.42-1.42l1.06 1.06a1 1 0 0 1-1.42 1.42Z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-zinc-200 dark:border-zinc-800">
      <div class="mx-auto flex max-w-4xl flex-col items-center justify-between gap-4 px-6 py-8 sm:flex-row">
        <p class="text-sm text-zinc-600 dark:text-zinc-400">
          © {new Date().getFullYear()} {SITE.name}
        </p>
        <div class="flex items-center gap-2">
          <SocialLinks socials={SOCIALS} />
          <a
            href="/rss.xml"
            title="RSS feed"
            aria-label="RSS feed"
            class="inline-flex rounded-lg p-2 text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3.75 3a.75.75 0 0 0 0 1.5 15.75 15.75 0 0 1 15.75 15.75.75.75 0 0 0 1.5 0C21 10.4 13.6 3 3.75 3Zm0 5.25a.75.75 0 0 0 0 1.5 10.5 10.5 0 0 1 10.5 10.5.75.75 0 0 0 1.5 0c0-6.628-5.373-12-12-12ZM6 18a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
            </svg>
          </a>
        </div>
      </div>
    </footer>

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
