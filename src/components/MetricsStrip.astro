---
import { impactMetrics, metricsAsOf, type ImpactMetric } from '../data/metrics';

interface Props {
  metrics?: ImpactMetric[];
  showAsOf?: boolean;
}

const { metrics = impactMetrics, showAsOf = true } = Astro.props;
---

<section aria-label="Selected impact metrics">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">
      Impact in numbers
    </h2>
    {showAsOf && (
      <span class="text-xs text-zinc-600 dark:text-zinc-400">as of {metricsAsOf}</span>
    )}
  </div>
  <dl class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
    {
      metrics.map((metric) => (
        <div class="rounded-xl border border-zinc-200 bg-white p-5 text-center dark:border-zinc-800 dark:bg-zinc-900">
          <dd
            class="text-2xl font-bold tracking-tight text-blue-600 sm:text-3xl dark:text-blue-400"
            data-count-to={metric.count?.to}
            data-prefix={metric.count?.prefix ?? ''}
            data-suffix={metric.count?.suffix ?? ''}
          >
            {metric.value}
          </dd>
          <dt class="mt-1 text-xs leading-snug text-zinc-600 sm:text-sm dark:text-zinc-400">{metric.label}</dt>
        </div>
      ))
    }
  </dl>
</section>

<script>
  // Subtle count-up as progressive enhancement: the server-rendered value is
  // always the source of truth, and reduced-motion users never see animation.
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedMotion && 'IntersectionObserver' in window) {
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const to = Number(el.dataset.countTo);
          if (!Number.isFinite(to)) continue;
          const prefix = el.dataset.prefix ?? '';
          const suffix = el.dataset.suffix ?? '';
          const duration = 900;
          const start = performance.now();
          const tick = (now: number) => {
            // rAF timestamps can predate performance.now(); clamp both ends
            const progress = Math.min(Math.max((now - start) / duration, 0), 1);
            el.textContent = `${prefix}${Math.round(easeOut(progress) * to)}${suffix}`;
            if (progress < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.4 }
    );
    document.querySelectorAll<HTMLElement>('[data-count-to]').forEach((el) => observer.observe(el));
  }
</script>
