---
// Leadership scope (personal-website-plan.md §3.6): dot clusters for team size,
// plus the recovery arc as a three-step sequence.
const clusters = [
  { label: 'Focused team initiatives', size: '3–4 engineers', dots: 4 },
  { label: 'Cross-team initiatives', size: '~10 engineers', dots: 10 },
];

const recovery = ['Projects already missed', 'Priorities · ownership · hands-on leadership', 'Delivered — trust restored'];
---

<div>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      clusters.map((cluster) => (
        <div class="rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900">
          <h3 class="text-sm font-bold uppercase tracking-wide text-zinc-900 dark:text-zinc-100">{cluster.label}</h3>
          <div class="mt-4 flex flex-wrap gap-1.5" role="img" aria-label={`${cluster.dots} dots representing ${cluster.size}`}>
            {Array.from({ length: cluster.dots }).map(() => (
              <span class="h-3 w-3 rounded-full bg-blue-500/80 dark:bg-blue-400/80" aria-hidden="true" />
            ))}
          </div>
          <p class="mt-3 text-sm font-medium text-zinc-600 dark:text-zinc-400">{cluster.size}</p>
        </div>
      ))
    }
  </div>

  <p class="mt-5 text-xs font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">The recovery arc</p>
  <p class="mt-2 flex flex-wrap items-center gap-x-1.5 gap-y-2 text-sm">
    {
      recovery.map((step, i) => (
        <>
          {i > 0 && <span class="text-zinc-400 dark:text-zinc-400" aria-hidden="true">→</span>}
          <span
            class:list={[
              'rounded-lg px-3 py-1.5 font-medium',
              i === recovery.length - 1
                ? 'bg-emerald-500/10 font-semibold text-emerald-700 dark:bg-emerald-400/10 dark:text-emerald-300'
                : 'bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300',
            ]}
          >
            {step}
          </span>
        </>
      ))
    }
  </p>
</div>
