---
// Ingestion leverage, kept deliberately abstract (personal-website-plan.md §3.4):
// many services → one typed library → queue → data lake.
---

<svg
  viewBox="0 0 720 260"
  class="w-full text-zinc-400"
  role="img"
  aria-label="Architecture: many microservices ingest through one type-safe library into a queue, which feeds the DataLake at roughly 2 to 2.5 million events per day. Demand spikes from examination schedules are absorbed by the queue."
>
  <title>Many microservices, one type-safe path into the data lake</title>
  <defs>
    <marker id="ing-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 Z" fill="currentColor" />
    </marker>
  </defs>

  <!-- services -->
  {
    [30, 105, 180].map((y) => (
      <g>
        <rect x="16" y={y} width="150" height="40" rx="10" class="fill-white stroke-zinc-300 dark:fill-zinc-900 dark:stroke-zinc-700" stroke-width="1.5" />
        <text x="91" y={y + 24} text-anchor="middle" class="fill-zinc-600 text-[12px] dark:fill-zinc-300">microservice</text>
      </g>
    ))
  }
  <path d="M166 50 C 205 50 205 116 236 118" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#ing-arrow)" />
  <path d="M166 125 L 236 125" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#ing-arrow)" />
  <path d="M166 200 C 205 200 205 140 236 132" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#ing-arrow)" />
  <text x="200" y="22" text-anchor="middle" class="fill-zinc-500 text-[11px] dark:fill-zinc-400">many producers</text>

  <!-- library -->
  <rect x="240" y="88" width="190" height="80" rx="12" class="fill-blue-500/5 stroke-blue-500 dark:stroke-blue-400" stroke-width="2" />
  <text x="335" y="116" text-anchor="middle" class="fill-zinc-800 text-[13px] font-semibold dark:fill-zinc-100">type-safe ingestion library</text>
  <text x="335" y="136" text-anchor="middle" class="fill-zinc-500 text-[11px] dark:fill-zinc-400">minimal integration effort · typed</text>
  <text x="335" y="152" text-anchor="middle" class="fill-zinc-500 text-[11px] dark:fill-zinc-400">consistent behavior</text>

  <path d="M430 128 L 494 128" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#ing-arrow)" />

  <!-- queue -->
  <rect x="500" y="103" width="92" height="50" rx="10" class="fill-white stroke-zinc-300 dark:fill-zinc-900 dark:stroke-zinc-700" stroke-width="1.5" />
  <text x="546" y="125" text-anchor="middle" class="fill-zinc-600 text-[12px] font-medium dark:fill-zinc-300">queue</text>
  <text x="546" y="141" text-anchor="middle" class="fill-zinc-500 text-[10px] dark:fill-zinc-400">retries · backoff</text>

  <path d="M592 128 L 626 128" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#ing-arrow)" />

  <!-- data lake -->
  <rect x="630" y="103" width="80" height="50" rx="10" class="fill-white stroke-zinc-300 dark:fill-zinc-900 dark:stroke-zinc-700" stroke-width="1.5" />
  <text x="670" y="132" text-anchor="middle" class="fill-zinc-600 text-[12px] font-medium dark:fill-zinc-300">DataLake</text>
  <text x="712" y="90" text-anchor="end" class="fill-zinc-500 text-[11px] dark:fill-zinc-400">~2–2.5M events/day</text>

  <text x="360" y="225" text-anchor="middle" class="fill-zinc-500 text-[11px] dark:fill-zinc-400">
    demand spikes from examination schedules are absorbed before the lake
  </text>
</svg>
